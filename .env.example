# Workspace
APP_WORKSPACE=/path/to/INE-Intelligent-Alarm-Repair-Assistant
SCHEDULE_EXPORT_CSV=/path/to/INE-Intelligent-Alarm-Repair-Assistant/dolphinscheduler/schedules_export.csv

# DolphinScheduler
DS_BASE_URL=http://your-ds-host:12345/dolphinscheduler
DS_TOKEN=replace_with_ds_token
DS_PROJECT_CODE=replace_with_main_project_code
DS_FUYAN_PROJECT_CODE=replace_with_fuyan_project_code
DS_FUYAN_PROJECT_NAME=replace_with_fuyan_project_name
DS_ENVIRONMENT_CODE=replace_with_environment_code
DS_TENANT_CODE=replace_with_tenant_code

# Recheck workflows
# Must be valid JSON array. Each item should include:
# project_name, project_code, workflow_name, workflow_code, schedule, level
FUYAN_WORKFLOWS_JSON=[{"project_name":"印尼数仓-质量校验","project_code":"replace_with_fuyan_project_code","workflow_name":"每日复验全级别数据(W-1)","workflow_code":"replace_with_workflow_code","schedule":"每日","level":"all"}]

# Database
DB_HOST=replace_with_db_host
DB_PORT=13306
DB_USER=replace_with_db_user
DB_PASSWORD=replace_with_db_password
DB_NAME=replace_with_db_name

# Alert / result tables
QUALITY_RESULT_TABLE=wattrel_quality_result
QUALITY_ALERT_TABLE=wattrel_quality_alert

# Auto repair strategy
SCAN_LOOKBACK_DAYS=8
WORKFLOW_CODE_ROOT=/data/git/starrocks/workflow
WORKFLOW_CODE_COUNTRY=ine
DS_API_GET_TIMEOUT_SECONDS=15
DS_API_GET_RETRY_COUNT=1
DS_WORKFLOW_LIST_PAGE_SIZE=100

# Per-country SR testdb alert queue (non-CN only; disabled until configured)
TESTDB_ALERT_QUEUE_ENABLED=false
SR_TESTDB_HOST=replace_with_sr_testdb_host
SR_TESTDB_PORT=9030
SR_TESTDB_USER=replace_with_sr_testdb_user
SR_TESTDB_PASSWORD=replace_with_sr_testdb_password
SR_TESTDB_DATABASE=testdb
TESTDB_ALERT_QUEUE_TABLE=intelligent_alarm_alert_queue
# Optional n8n root-cause analysis for 90d/1y anomalies. The AI response is
# stored only as audit evidence and is never executed as SQL or DS commands.
AI_ROOT_CAUSE_WEBHOOK_URL=
AI_ROOT_CAUSE_WEBHOOK_TOKEN=
AI_ROOT_CAUSE_TIMEOUT_SECONDS=30
# Enables the two-stage AI + SRBox locator only for 90d/1y alerts.  The CLI
# retains SSO authentication; never configure a shared production credential.
SRBOX_TIME_LOCATION_ENABLED=false
SRBOX_CLIENT_PATH=/absolute/path/to/sr_gateway_client.py
SRBOX_QUERY_TIMEOUT_SECONDS=60
SRBOX_MAX_RESULT_ROWS=400

# OpenClaw webhook
OPENCLAW_WEBHOOK=http://127.0.0.1:18789/hooks/wattrel/wake
OPENCLAW_HOOK_TOKEN=replace_with_openclaw_hook_token

# TV bot
TV_API_URL=https://tv-service-alert.kuainiu.chat/alert/v2/array
TV_BOT_ID=replace_with_tv_bot_id
TV_APP_ID=alert
TV_MENTIONS=何柳琴,翟爽

# sadpay 推送业务库监控告警（alert/pk_sadapay_dwd_push_monitor_alert.py）
# DS 访问走 n8n ds-scheduler 网关 webhook（country=pk）
DS_SCHEDULER_WEBHOOK_URL=https://sql-cn.kuainiujinke.com/webhook/ds-scheduler
# 巴基斯坦 DS token（按 DS_API_TOKEN_PK / PK_DS_TOKEN / DS_TOKEN 顺序读取）
DS_API_TOKEN_PK=replace_with_pk_ds_token
# 该告警 @ 人邮箱（默认 gretchenhe@kn.group = 何柳琴）
SADPAY_TV_MENTIONS=gretchenhe@kn.group
