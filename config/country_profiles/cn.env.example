# ---- 投放相关表（dwd_ad_/dwd_tt_/dwd_fb_/dwd_gg_ 等）修复配置（可选） ----
# 仅投放相关表走“投放平台”项目 + 补数(COMPLEMENT_DATA)修复；其余表保持传 dt 不变。
# 中国不启用投放平台搜索（保持主项目 + 传 dt 逻辑不变），各国标准项目名可整体覆盖：
# DS_AD_PLATFORM_PROJECT_NAMES_JSON={}
# 如需显式指定投放平台项目 code（优先级最高），取消注释并填写：
# DS_AD_PLATFORM_PROJECT_CODES_JSON=[{"code":"replace_with_ad_project_code","name":"中国-投放平台"}]
# 标准名匹配不到时按关键字兜底：
# DS_AD_PLATFORM_PROJECT_NAME_KEYWORD=投放平台
# AD_TABLE_PREFIXES_JSON=["dwd_ad_", "dwd_tt_", "dwd_fb_", "dwd_gg_"]
# 投放工作流为当天调度(D 跑 dt=D)时改为 0；默认 1（D-1 口径：D 跑 dt=D-1）
# AD_COMPLEMENT_SCHEDULE_OFFSET_DAYS=1
